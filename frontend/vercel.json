{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kalkulatortik.com"
        }
      ],
      "destination": "https://www.kalkulatortik.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kalkulatortiktok.vercel.app"
        }
      ],
      "destination": "https://www.kalkulatortik.com/:path*",
      "permanent": true
    },
    {
      "source": "/:slug(calculator|about|faq|contact|privacy|terms|tiktok-cpm-calculator|tiktok-engagement-calculator)/",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/:lang(id|de|es|fr|it|ms|pt)/:slug(calculator|about|faq|contact|privacy|terms|tiktok-cpm-calculator|tiktok-engagement-calculator)/",
      "destination": "/:lang/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tik-calculator-website-ljy6.vercel.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    }
  ]
}
